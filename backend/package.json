{
  "name": "hardware-erp-backend",
  "version": "1.0.0",
  "description": "Hardware Store ERP - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "worker": "node worker.js",
    "test": "npm run test:environment && npm run test:security && npm run test:containment && npm run test:financial && npm run test:documents",
    "test:security": "node ../scripts/run-local-tests.cjs --test tests/security/*.test.js",
    "test:containment": "node ../scripts/run-local-tests.cjs --test tests/containment/*.test.js",
    "test:environment": "node ../scripts/run-local-tests.cjs --test tests/environment/*.test.js",
    "test:release-blockers": "node ../scripts/run-local-tests.cjs --test tests/release-blockers/*.test.js",
    "migrate": "node ../db/migrations/index.js",
    "seed:test": "node ../db/seeds/index.js",
    "lint": "eslint src server.js worker.js document-worker.js scripts tests",
    "check:syntax": "node scripts/check-syntax.js",
    "test:financial": "node ../scripts/run-local-tests.cjs --test tests/phase2/*.test.js tests/phase3/*.test.js tests/phase4/*.test.js tests/financial/*.test.js",
    "test:documents": "node ../scripts/run-local-tests.cjs --test tests/phase5b/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/client-ses": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "supertest": "^6.3.4",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0"
}
