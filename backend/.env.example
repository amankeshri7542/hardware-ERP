# Disposable native local/test setup only. Generate separate values; never reuse production secrets.
NODE_ENV=test
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hardware_erp_test
DB_USER=erp_app
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA_PATH=
MIGRATION_DB_USER=erp_migrator
MIGRATION_DB_PASSWORD=
SESSION_SECRET=
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
STORAGE_DRIVER=disabled
# Optional synthetic bootstrap only; password must be supplied explicitly.
TEST_ADMIN_PASSWORD=
# Production has a separate operator-created .env.production: NODE_ENV=production,
# HTTPS_ENABLED=true, DB_SSL=true, valid DB CA, exact HTTPS CORS origin and real secrets.
# See docs/LOCAL-DEVELOPMENT.md and docs/SECURITY-RUNBOOK.md; release remains blocked.
