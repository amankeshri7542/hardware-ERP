{
  "name": "hardware-erp-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hardware Store ERP - Frontend",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "node ../scripts/run-local-tests.cjs ../scripts/run-browser-tests.cjs tests/browser.test.js",
    "test:auth": "node ../scripts/run-local-tests.cjs --test tests/auth.test.js",
    "lint": "eslint src",
    "test:financial": "node ../scripts/run-local-tests.cjs --test tests/financial.test.js tests/phase3.test.js tests/phase4.test.js tests/phase5b.test.js",
    "test:financial-browser": "node ../scripts/run-local-tests.cjs ../scripts/run-browser-tests.cjs tests/financial-browser.test.js",
    "test:phase3-browser": "node ../scripts/run-local-tests.cjs ../scripts/run-browser-tests.cjs tests/phase3-browser.test.js",
    "test:phase4-browser": "node ../scripts/run-local-tests.cjs ../scripts/run-browser-tests.cjs tests/phase4-browser.test.js",
    "test:browser-all": "node ../scripts/run-local-tests.cjs ../scripts/run-browser-tests.cjs tests/browser.test.js tests/financial-browser.test.js tests/phase3-browser.test.js tests/phase4-browser.test.js && npm run test:phase5b-browser",
    "test:phase5b-browser": "node ../scripts/run-local-tests.cjs ../scripts/run-browser-tests.cjs tests/phase5b-browser.test.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "antd": "^5.14.0",
    "@ant-design/icons": "^5.3.0",
    "axios": "1.20.0",
    "zustand": "^4.5.0",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.3.5",
    "@playwright/test": "^1.58.2",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0"
}
